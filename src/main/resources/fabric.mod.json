{
  "schemaVersion": 1,
  "id": "stf",
  "version": "${version}",
  "name": "Shit To Fit",
  "description": "A Fabric mod",
  "authors": [
    "Neuromuser"
  ],
  "contact": {
    "sources": "https://github.com/neuromuser/shit-to-fit"
  },
  "license": "MIT",
  "icon": "assets/stf/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.neuromuser.stf.SweatToFitMod"
    ],
    "client": [
      "com.neuromuser.stf.SweatToFitClientMod"
    ],
    "cardinal-components": [
      "com.neuromuser.stf.components.ModComponents"
    ],
    "modmenu": [
      "com.neuromuser.stf.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "shit-to-fit.mixins.json",
    {
      "config": "shit-to-fit.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "cardinal-components": [
      "stf:player_data"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*",
    "owo": "*",
    "cloth-config": "*"
  }
}